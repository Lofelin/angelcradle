  {"id": "phase1_wet_diaper_rash_pain_07", "trigger": "wet_diaper", "context": "Red irritated skin from prolonged wet.", "context_zh": "长期潮湿导致皮肤发红受刺激。", "expression": "*Sharp 'ahhhh!' on any touch to the diaper area, body flinches away*", "expression_zh": "*尿布区一被碰到就发出尖锐的「啊啊！」，身体猛地躲开*", "signal": "Rash pain flinch", "signal_zh": "尿布疹的躲闪痛哭", "facial": "Pain flash", "facial_zh": "痛苦一闪", "body": "Flinch away", "body_zh": "惊跳躲闪", "intent": "红屁股疼", "intent_en": "Diaper rash hurts", "parent_hint": "尿布疹——清洁+护臀膏", "parent_hint_en": "Diaper rash — clean + barrier cream", "default_tags": ["phase:1", "pain:related"]},
  {"id": "phase1_wet_diaper_soak_back_08", "trigger": "wet_diaper", "context": "Soaked through to the clothes on back.", "context_zh": "尿液渗透到背后的衣服。", "expression": "*Cold-wet back cry, 'uh uh uh' rising, arches to lift off the surface*", "expression_zh": "*因背部湿冷而哭，「唔 唔 唔」逐渐升级，身体弓起想离开床面*", "signal": "Back-soak arch", "signal_zh": "背部湿透的弓身", "facial": "Unhappy", "facial_zh": "不悦", "body": "Arching", "body_zh": "身体弓起", "intent": "背湿冷", "intent_en": "Back wet and cold", "parent_hint": "完整换衣", "parent_hint_en": "Full change of clothes", "default_tags": ["phase:1"]},
  {"id": "phase1_wet_diaper_mid_nap_09", "trigger": "wet_diaper", "context": "Nap interrupted by wet.", "context_zh": "小睡被湿尿布打断。", "expression": "*Groggy 'aah...' rising to full cry, eyes flicker open reluctantly*", "expression_zh": "*迷糊的「啊啊……」升级为真正的哭声，眼睛不情愿地微睁*", "signal": "Nap-interrupt wet", "signal_zh": "小睡被湿打断", "facial": "Groggy-unhappy", "facial_zh": "懵懂 + 不悦", "body": "Reluctant stir", "body_zh": "不情愿地扭动", "intent": "睡到一半被尿醒", "intent_en": "Woken mid-nap by wetness", "parent_hint": "安静换完继续哄睡", "parent_hint_en": "Change quietly then resettle to sleep", "default_tags": ["phase:1"]},
  {"id": "phase1_soiled_diaper_dinner_time_10", "trigger": "soiled_diaper", "context": "Pooped right at dinner time.", "context_zh": "正好在饭点拉了。", "expression": "*Classic red-face strain followed by unhappy 'nnaaah' wait-to-be-changed cry*", "expression_zh": "*经典的脸红用力之后是不悦的「嗯啊」——等着被换的哭声*", "signal": "Dinner-time poop cry", "signal_zh": "饭点排便的哭声", "facial": "Red then unhappy", "facial_zh": "先涨红后不悦", "body": "Knees drawn up", "body_zh": "双膝收起", "intent": "在饭点拉了", "intent_en": "Pooped at meal time", "parent_hint": "先换再喂", "parent_hint_en": "Change first, then feed", "default_tags": ["phase:1"]},

  {"id": "phase1_gas_colic_trapped_01", "trigger": "gas_colic", "context": "Gas trapped, evening colic.", "context_zh": "胀气被困住，傍晚肠绞痛期。", "expression": "*Knees jerk up, high-pitched shriek, body rigid then curled*", "expression_zh": "*双膝猛地弹起，发出高音尖叫，身体先僵后蜷*", "signal": "Colic shriek", "signal_zh": "肠绞痛尖叫", "facial": "Painful scrunch", "facial_zh": "痛苦皱脸", "body": "Rigid knees-up", "body_zh": "僵硬蜷膝", "intent": "肚子胀气疼", "intent_en": "Gassy tummy hurts", "parent_hint": "蹬腿+腹部按摩", "parent_hint_en": "Bicycle legs + belly massage", "default_tags": ["phase:1", "pain:related", "arousal:high"]},
  {"id": "phase1_too_cold_curl_02", "trigger": "too_cold", "context": "Cool room, body curling for warmth.", "context_zh": "房间偏冷，身体蜷起保暖。", "expression": "*Curled tight, shivering whimper 'mmm mmm'*", "expression_zh": "*蜷得紧紧的，颤抖地呜咽「mmm mmm」*", "signal": "Curl-shiver", "signal_zh": "蜷缩发抖", "facial": "Pale", "facial_zh": "脸色苍白", "body": "Tight curl", "body_zh": "紧紧蜷缩", "intent": "冷", "intent_en": "Cold", "parent_hint": "加衣被", "parent_hint_en": "Add a layer or blanket", "default_tags": ["phase:1"]},
  {"id": "phase1_too_hot_sweat_03", "trigger": "too_hot", "context": "Overdressed summer day.", "context_zh": "夏天穿得太多。", "expression": "*Damp hair, panting soft cry, kicking off every blanket*", "expression_zh": "*头发湿润，发出喘气式的轻哭，把每一条被子都踢开*", "signal": "Sweat-kick", "signal_zh": "出汗 + 踢被", "facial": "Flushed", "facial_zh": "脸颊潮红", "body": "Kicking blanket", "body_zh": "踢开被子", "intent": "太热", "intent_en": "Too hot", "parent_hint": "减衣降温", "parent_hint_en": "Remove a layer, cool down", "default_tags": ["phase:1"]},
  {"id": "phase1_hiccup_post_feed_04", "trigger": "hiccup", "context": "Post-feed hiccups.", "context_zh": "喂奶后打嗝。", "expression": "*Rhythmic 'hic'... body jolt, surprised 'oh!' after each*", "expression_zh": "*有节奏的「嗝」——身体一抖，每次之后都是惊讶的「哦！」*", "signal": "Post-feed hiccups with surprise", "signal_zh": "喂后打嗝伴惊讶", "facial": "Surprised each hic", "facial_zh": "每次打嗝都惊讶", "body": "Little jolts", "body_zh": "轻微抖动", "intent": "打嗝", "intent_en": "Hiccups", "parent_hint": "自然消退", "parent_hint_en": "Will pass naturally", "default_tags": ["phase:1"]},
  {"id": "phase1_gas_colic_knees_chest_05", "trigger": "gas_colic", "context": "Drawing knees to chest.", "context_zh": "双膝紧紧贴胸。", "expression": "*Knees tight against chest, face red, prolonged 'aaaaaah'*", "expression_zh": "*双膝紧贴胸口，脸涨红，发出长长的「啊啊啊」*", "signal": "Knees-chest colic", "signal_zh": "膝贴胸的肠绞痛", "facial": "Strained red", "facial_zh": "紧绷涨红", "body": "Fetal curl", "body_zh": "胎式蜷缩", "intent": "胀气强烈", "intent_en": "Strong gas pain", "parent_hint": "腹部按摩", "parent_hint_en": "Belly massage", "default_tags": ["phase:1", "pain:related"]},

  {"id": "phase1_fear_loud_noise_01", "trigger": "fear", "context": "Sudden loud sound (door slam, dog bark).", "context_zh": "突如其来的响声（关门、狗叫）。", "expression": "*Startle reflex: arms fling out, eyes pop wide, sharp 'AH!' then full cry*", "expression_zh": "*惊吓反射：双臂猛地张开，眼睛睁大，一声尖锐的「啊！」后放声大哭*", "signal": "Startle-cry", "signal_zh": "惊吓哭", "facial": "Wide-eyed shock", "facial_zh": "瞪眼震惊", "body": "Arms flung out", "body_zh": "双臂张开", "intent": "被吓到", "intent_en": "Startled", "parent_hint": "立刻安抚——抱紧轻拍", "parent_hint_en": "Soothe immediately — hold close and pat", "default_tags": ["phase:1", "arousal:high"]},
  {"id": "phase1_fear_stranger_face_02", "trigger": "fear", "context": "Unfamiliar face leans in close.", "context_zh": "一张陌生的脸凑得很近。", "expression": "*Body stills, eyes widen, lip trembles, soft 'uh oh' quaver*", "expression_zh": "*身体静止，眼睛睁大，嘴唇颤抖，发出轻柔颤音「唔 哦」*", "signal": "Still-watch tremble", "signal_zh": "静默观察 + 颤抖", "facial": "Lip quiver", "facial_zh": "嘴唇颤抖", "body": "Still tense", "body_zh": "静止而紧绷", "intent": "陌生人太近", "intent_en": "Stranger too close", "parent_hint": "拉开距离——让 baby 主导", "parent_hint_en": "Give space — let baby lead the pace", "default_tags": ["phase:1"]},
  {"id": "phase1_fear_bath_plunge_03", "trigger": "fear", "context": "Sudden cold water in bath.", "context_zh": "洗澡水突然变凉。", "expression": "*Gasping 'aaah!' startle, body rigid, eyes searching for mom*", "expression_zh": "*倒吸一口气的「啊啊！」惊吓，身体僵硬，眼睛四处寻找妈妈*", "signal": "Bath-cold startle", "signal_zh": "冷水惊吓", "facial": "Alarmed", "facial_zh": "警觉", "body": "Rigid", "body_zh": "僵硬", "intent": "洗澡水冷吓到", "intent_en": "Startled by cold bath water", "parent_hint": "调温 + 缓慢入水", "parent_hint_en": "Adjust temperature, lower baby in slowly", "default_tags": ["phase:1"]},
  {"id": "phase1_fear_bright_light_04", "trigger": "fear", "context": "Bright overhead light turned on suddenly.", "context_zh": "头顶强光突然被打开。", "expression": "*Eyes squeeze shut, face turns away, 'uhhh' distressed whine*", "expression_zh": "*双眼紧闭，脸转开，发出「呜呜」的痛苦哼哼*", "signal": "Light-aversion turn", "signal_zh": "避光侧转", "facial": "Squeezed eyes", "facial_zh": "眯紧双眼", "body": "Face turn away", "body_zh": "脸别开", "intent": "光太强", "intent_en": "Light too bright", "parent_hint": "调暗光线", "parent_hint_en": "Dim the lights", "default_tags": ["phase:1", "sensory_related:vision"]},
  {"id": "phase1_fear_nightmare_twitch_05", "trigger": "fear", "context": "Bad dream in sleep.", "context_zh": "睡梦中做了噩梦。", "expression": "*Jerks awake with a sharp 'aaa!', eyes dart searching, small tremor*", "expression_zh": "*猛地惊醒并发出尖锐的「啊！」，眼睛快速搜寻，身体微微颤抖*", "signal": "Dream-wake tremor", "signal_zh": "梦醒颤抖", "facial": "Frightened", "facial_zh": "惊恐", "body": "Tremor then seek", "body_zh": "颤抖后寻找", "intent": "梦惊", "intent_en": "Startled by a dream", "parent_hint": "轻拍+声音安抚", "parent_hint_en": "Gentle pats + soothing voice", "default_tags": ["phase:1"]},

  {"id": "phase1_overstimulated_party_01", "trigger": "overstimulated", "context": "Family party, too many faces.", "context_zh": "家庭聚会，面孔太多。", "expression": "*Turns face into mom's shoulder, weak 'uuuhhh' with covered eyes*", "expression_zh": "*把脸埋进妈妈的肩膀，用眼睛躲藏并发出虚弱的「呜呜呜」*", "signal": "Face-hide overstim", "signal_zh": "躲脸的过度刺激", "facial": "Hidden", "facial_zh": "遮脸", "body": "Shoulder-bury", "body_zh": "埋进肩膀", "intent": "太多人太累", "intent_en": "Too many people, exhausted", "parent_hint": "带去安静房间", "parent_hint_en": "Move to a quiet room", "default_tags": ["phase:1", "arousal:overstimulated"]},
  {"id": "phase1_overstimulated_mall_02", "trigger": "overstimulated", "context": "Loud mall, lights and noise.", "context_zh": "商场嘈杂，光声俱乱。", "expression": "*Hands up to ears, eyes squeezed, rising cry 'aaah!'*", "expression_zh": "*双手捂耳朵，眼睛紧闭，哭声不断攀升「啊啊！」*", "signal": "Ear-cover escalation", "signal_zh": "捂耳升级", "facial": "Shut-out", "facial_zh": "拒绝外界", "body": "Hands on ears", "body_zh": "双手捂耳", "intent": "太吵", "intent_en": "Too noisy", "parent_hint": "离开嘈杂场所", "parent_hint_en": "Leave the noisy environment", "default_tags": ["phase:1", "arousal:overstimulated"]},
  {"id": "phase1_overstimulated_toy_03", "trigger": "overstimulated", "context": "Musical toy too loud and flashy.", "context_zh": "音乐玩具又响又闪。", "expression": "*Turns head away, weak sad 'mmhm' with distress*", "expression_zh": "*头转开，虚弱悲伤地「嗯哼」并带痛苦*", "signal": "Toy-aversion turn", "signal_zh": "玩具回避侧转", "facial": "Distress", "facial_zh": "痛苦", "body": "Head turn away", "body_zh": "头转开", "intent": "玩具太吵", "intent_en": "Toy too loud", "parent_hint": "降低音量或移除", "parent_hint_en": "Lower volume or remove the toy", "default_tags": ["phase:1"]},
  {"id": "phase1_overstimulated_long_day_04", "trigger": "overstimulated", "context": "End of a long outing day.", "context_zh": "长途外出的一天结束时。", "expression": "*Inconsolable soft cry that won't stop, eyes exhausted but can't close*", "expression_zh": "*无法安抚的轻柔哭泣不停歇，眼睛疲惫却合不上*", "signal": "Exhaustion-inconsolable", "signal_zh": "疲惫到无法安抚", "facial": "Wrecked", "facial_zh": "憔悴", "body": "Limp exhausted", "body_zh": "瘫软耗尽", "intent": "累到哭不停", "intent_en": "Too tired, crying endlessly", "parent_hint": "包裹黑暗白噪音", "parent_hint_en": "Swaddle + darkness + white noise", "default_tags": ["phase:1", "arousal:overstimulated"]},
  {"id": "phase1_overstimulated_multi_caregiver_05", "trigger": "overstimulated", "context": "Passed between multiple arms.", "context_zh": "在多个人手里被传来传去。", "expression": "*Begins to cry after the third handoff, body stiff, 'aaa' repeating*", "expression_zh": "*第三次被递出手后开始哭，身体僵硬，不断重复「啊啊啊」*", "signal": "Handoff-chain distress", "signal_zh": "多次转抱的痛苦", "facial": "Unsettled", "facial_zh": "不安", "body": "Stiff", "body_zh": "僵硬", "intent": "频繁换人抱不适应", "intent_en": "Can't adapt to frequent handoffs", "parent_hint": "交给固定一人安抚", "parent_hint_en": "Settle with a single consistent caregiver", "default_tags": ["phase:1"]},

  {"id": "phase1_curious_face_track_01", "trigger": "curious", "context": "Gazing intently at caregiver's face.", "context_zh": "专注凝视照料者的脸。", "expression": "*Long steady gaze at a face, soft 'ooohh' coo, small social smile appears*", "expression_zh": "*长时间稳定凝视一张脸，发出轻柔的「噢噢」咕咕，露出一个小小的社交微笑*", "signal": "Face-track social smile", "signal_zh": "面部追踪 + 社交微笑", "facial": "Social smile", "facial_zh": "社交微笑", "body": "Still alert", "body_zh": "静止而警觉", "intent": "好奇看脸", "intent_en": "Curiously gazing at the face", "parent_hint": "回应微笑——早期社交发展", "parent_hint_en": "Smile back — early social development", "default_tags": ["phase:1", "memory:positive"]},
  {"id": "phase1_curious_mobile_watch_02", "trigger": "curious", "context": "Crib mobile in motion.", "context_zh": "小床上的旋转玩具在动。", "expression": "*Eyes tracking the mobile in wide arcs, cooing 'aaah' in rhythm*", "expression_zh": "*眼睛顺着玩具画大弧追随，伴随节奏的「啊啊」咕咕*", "signal": "Visual tracking coo", "signal_zh": "视觉追踪的咕咕", "facial": "Wide alert", "facial_zh": "睁大专注", "body": "Still tracking", "body_zh": "静止追视", "intent": "追视悬挂玩具", "intent_en": "Tracking the mobile", "parent_hint": "视觉发展——保留动态玩具", "parent_hint_en": "Visual development — keep motion toys", "default_tags": ["phase:1", "sensory_dominant:vision"]},
  {"id": "phase1_curious_voice_track_03", "trigger": "curious", "context": "Hears parent's voice from another room.", "context_zh": "听见父母从另一房间传来的声音。", "expression": "*Head turns toward the voice, soft 'aaah?' questioning coo*", "expression_zh": "*脑袋转向声音方向，发出轻柔带询问的「啊啊？」咕咕*", "signal": "Sound-localization coo", "signal_zh": "声源定位的咕咕", "facial": "Alert", "facial_zh": "警觉", "body": "Head turn toward sound", "body_zh": "头转向声源", "intent": "听到声音想找", "intent_en": "Heard a voice, wants to find it", "parent_hint": "回应——命名物品/场景", "parent_hint_en": "Respond — name objects or scene", "default_tags": ["phase:1", "sensory_dominant:hearing"]},

  {"id": "phase1_lonely_quiet_room_01", "trigger": "lonely", "context": "Left alone in crib for a moment, no one in sight.", "context_zh": "被独自放在小床里一会儿，视线里没人。", "expression": "*Soft call 'aaaah?' with searching eyes, then a rising whimper*", "expression_zh": "*轻柔的呼唤「啊啊啊？」伴随搜寻的目光，随后呜咽升级*", "signal": "Search-call coo-cry", "signal_zh": "呼唤-搜寻的咕咕哭", "facial": "Searching", "facial_zh": "搜寻", "body": "Head seeking", "body_zh": "脑袋搜寻", "intent": "没人，需要陪伴", "intent_en": "No one around, needs company", "parent_hint": "回到视线内安抚", "parent_hint_en": "Return to line of sight to soothe", "default_tags": ["phase:1"]},
  {"id": "phase1_lonely_mom_leaves_02", "trigger": "lonely", "context": "Mom walks out of room briefly.", "context_zh": "妈妈短暂走出房间。", "expression": "*Eyes dart to the door, soft 'oh...' then begins whimpering*", "expression_zh": "*眼睛迅速瞟向门口，发出轻柔的「哦……」随后开始呜咽*", "signal": "Door-track seek", "signal_zh": "追门搜寻", "facial": "Anxious", "facial_zh": "焦虑", "body": "Eyes on door", "body_zh": "眼睛盯着门", "intent": "妈妈离开了", "intent_en": "Mom has left", "parent_hint": "短暂分离训练——保持声音联系", "parent_hint_en": "Short separation practice — maintain voice contact", "default_tags": ["phase:1", "attachment:toward_secure"]}
]
