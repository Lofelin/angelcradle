  {"id": "phase1_hunger_scheduled_01", "trigger": "hunger", "context": "Regular 3-hour feeding interval reached.", "context_zh": "距上次喂奶 3 小时，到点了。", "expression": "*Turns head toward breast/bottle source with a soft 'mmmm', opening mouth in anticipation*", "expression_zh": "*转头朝乳房或奶瓶方向，发出轻柔的「mmmm」，期待地张开嘴*", "signal": "Anticipatory mouth opening with coo", "signal_zh": "预期性张嘴并发出咕咕声", "facial": "Mouth open, eyes tracking", "facial_zh": "嘴巴张开，眼睛在追踪", "body": "Head turning toward source", "body_zh": "头转向奶源方向", "intent": "饿了要喝奶（预期反应）", "intent_en": "Hungry, wants a feed (anticipatory)", "parent_hint": "定时喂食到了", "parent_hint_en": "Scheduled feeding time", "default_tags": ["phase:1"]},
  {"id": "phase1_hunger_see_bottle_02", "trigger": "hunger", "context": "Sees the bottle being prepared.", "context_zh": "看到奶瓶正在准备。", "expression": "*Eyes lock onto the bottle, legs kick with excitement, soft 'ah-ah' cooing escalating into whimper*", "expression_zh": "*眼睛锁定奶瓶，双腿兴奋地踢动，轻柔的「啊-啊」咕咕声逐渐升级为呜咽*", "signal": "Visual tracking with cooing", "signal_zh": "视觉追踪 + 咕咕声", "facial": "Wide alert eyes", "facial_zh": "眼睛睁大专注", "body": "Excited leg kicks", "body_zh": "兴奋地踢腿", "intent": "看见奶瓶想快点", "intent_en": "Seeing the bottle, wants it faster", "parent_hint": "视觉关联饥饿——喂食前等待时间缩短", "parent_hint_en": "Vision–hunger association forming — shorten wait before feeding", "default_tags": ["phase:1", "sensory_dominant:vision"]},
  {"id": "phase1_hunger_dinner_cluster_03", "trigger": "hunger", "context": "Evening cluster, wants to be on breast often.", "context_zh": "黄昏簇拥哺乳期，想频繁挂在乳房上。", "expression": "*Urgent soft 'ah ah ah' cooing with squirming, face turning to anyone nearby*", "expression_zh": "*急切而轻柔的「啊 啊 啊」咕咕声伴随扭动，脸转向任何靠近的人*", "signal": "Evening cluster fuss coo", "signal_zh": "傍晚簇拥哺乳的烦躁咕咕", "facial": "Searching", "facial_zh": "搜寻的神情", "body": "Squirming toward adult", "body_zh": "朝大人扭动靠近", "intent": "黄昏簇拥哺乳", "intent_en": "Dusk cluster feeding", "parent_hint": "黄昏频繁哺乳——正常发育", "parent_hint_en": "Frequent dusk feeds — normal development", "default_tags": ["phase:1"]},
  {"id": "phase1_hunger_soft_coo_04", "trigger": "hunger", "context": "Early hunger, still calm.", "context_zh": "早期饿意，仍然平静。", "expression": "*Soft 'oo oo' coo, gentle rooting head turns*", "expression_zh": "*轻柔的「喔 喔」咕咕声，温和的觅食式转头*", "signal": "Soft coo pre-hunger", "signal_zh": "前饥饿期的轻咕咕", "facial": "Relaxed alert", "facial_zh": "放松但警觉", "body": "Gentle head turns", "body_zh": "温和地转头", "intent": "早期饿意", "intent_en": "Early hunger", "parent_hint": "尽早喂食避免崩溃", "parent_hint_en": "Feed early to avoid a meltdown", "default_tags": ["phase:1"]},
  {"id": "phase1_hunger_rising_cry_05", "trigger": "hunger", "context": "Been cooing, now rising to cry.", "context_zh": "本来在咕咕，现在开始升级为哭。", "expression": "*Whimpery 'aaaah' rising in pitch, fists flying to mouth, head thrashing*", "expression_zh": "*音调越来越高的呜咽「啊啊啊」，拳头飞快地送进嘴里，脑袋来回甩动*", "signal": "Escalating hunger whimper", "signal_zh": "饥饿呜咽升级", "facial": "Lips open, red", "facial_zh": "嘴唇张开，脸涨红", "body": "Fists to mouth", "body_zh": "拳头送向嘴巴", "intent": "饿升级", "intent_en": "Hunger escalating", "parent_hint": "立刻喂——否则过哭状态", "parent_hint_en": "Feed now — otherwise risks overcrying", "default_tags": ["phase:1", "arousal:moderate"]},
  {"id": "phase1_hunger_night_wake_06", "trigger": "hunger", "context": "2am feed.", "context_zh": "凌晨两点的夜奶时间。", "expression": "*Soft but insistent 'mm mm mm' rising to a cry, eyes closed*", "expression_zh": "*轻柔但执拗的「mm mm mm」逐渐升级为哭声，眼睛依然闭着*", "signal": "Night feed wake coo-cry", "signal_zh": "夜奶醒时的咕咕哭", "facial": "Eyes closed, mouth open", "facial_zh": "闭眼张嘴", "body": "Head rolling toward parent", "body_zh": "脑袋朝家长的方向滚去", "intent": "夜间喂奶", "intent_en": "Night feeding", "parent_hint": "夜奶醒——温和喂食", "parent_hint_en": "Night feed wake — feed gently", "default_tags": ["phase:1"]},
  {"id": "phase1_hunger_stalling_bottle_07", "trigger": "hunger", "context": "Bottle is coming but too slowly.", "context_zh": "奶瓶在路上但来得太慢。", "expression": "*Sharp 'waaah' protest followed by frantic 'ah ah' when source is visible but not offered*", "expression_zh": "*先是一声尖锐的「哇啊啊」抗议，看见奶源却拿不到时接上急切的「啊 啊」*", "signal": "Protest wait cry", "signal_zh": "抗议等待的哭声", "facial": "Urgent distress", "facial_zh": "急迫的痛苦神情", "body": "Reaching arms", "body_zh": "双臂伸出", "intent": "奶就在眼前但吃不到", "intent_en": "Milk in sight but out of reach", "parent_hint": "减少等待时间", "parent_hint_en": "Reduce the waiting time", "default_tags": ["phase:1"]},
  {"id": "phase1_hunger_weak_preemie_08", "trigger": "hunger", "context": "Preemie/weak baby, gentle hunger cues.", "context_zh": "早产或体弱 baby，饥饿信号很微弱。", "expression": "*Very soft 'ooh' coo, small tongue movements, eyes half-open*", "expression_zh": "*非常轻柔的「噢」咕咕，小舌头微动，眼睛半睁*", "signal": "Weak preemie cue", "signal_zh": "早产儿的微弱信号", "facial": "Soft, tired", "facial_zh": "柔和而疲惫", "body": "Barely moving", "body_zh": "几乎不动", "intent": "虚弱饿", "intent_en": "Weak hunger", "parent_hint": "需主动定时喂奶", "parent_hint_en": "Proactive scheduled feeding needed", "default_tags": ["phase:1", "defect:related"]},
  {"id": "phase1_hunger_recognize_mom_09", "trigger": "hunger", "context": "Mom walks in — baby associates her with feeding.", "context_zh": "妈妈走进来——baby 已经把她和喂奶联系起来。", "expression": "*Eyes lock onto mom, excited leg kicks, 'ah ah' cooing urgently*", "expression_zh": "*眼睛锁定妈妈，双腿兴奋地踢动，急切地发出「啊 啊」咕咕声*", "signal": "Caregiver-recognition hunger coo", "signal_zh": "识别照料者的饥饿咕咕", "facial": "Alert wide eyes", "facial_zh": "眼睛睁大警觉", "body": "Excited limb kicks", "body_zh": "四肢兴奋地挥踢", "intent": "看到妈妈就想吃", "intent_en": "Seeing mom triggers hunger", "parent_hint": "早期关联学习——视觉→哺乳", "parent_hint_en": "Early associative learning — sight → feeding", "default_tags": ["phase:1", "attachment:toward_secure"]},
  {"id": "phase1_hunger_after_bath_10", "trigger": "hunger", "context": "Fresh out of bath, bath burned energy.", "context_zh": "刚出浴，洗澡消耗了能量。", "expression": "*Relaxed but rooting, soft 'mmm' while head turns toward caregiver's chest*", "expression_zh": "*放松但在觅食，一边发出轻柔的「mmm」一边把头转向照料者的胸口*", "signal": "Post-bath rooting coo", "signal_zh": "出浴后的觅食咕咕", "facial": "Calm alert", "facial_zh": "平静但警觉", "body": "Rooting toward warmth", "body_zh": "朝温暖处觅食", "intent": "洗澡后饿", "intent_en": "Hungry after bath", "parent_hint": "洗澡后常伴哺乳", "parent_hint_en": "Post-bath feed is typical", "default_tags": ["phase:1"]},

