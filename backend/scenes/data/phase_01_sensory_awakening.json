  {"id": "phase1_sleepy_stimulating_day_07", "trigger": "sleepy", "context": "Too much activity today, fried.", "context_zh": "今天活动太多，累坏了。", "expression": "*Eyes fighting to stay open, weak 'mm...mm' while limbs go loose*", "expression_zh": "*眼睛努力撑开，发出微弱的「嗯…嗯」，四肢逐渐松弛*", "signal": "Post-stim fading cue", "signal_zh": "刺激后的消退信号", "facial": "Blurring", "facial_zh": "神色模糊", "body": "Slumping", "body_zh": "瘫软下去", "intent": "刺激过多后困", "intent_en": "Sleepy after overstimulation", "parent_hint": "黑暗安静助眠", "parent_hint_en": "Dark and quiet environment aids sleep", "default_tags": ["phase:1", "arousal:overstimulated"]},
