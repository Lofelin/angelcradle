  {"id": "phase1_sleepy_rub_eye_03", "trigger": "sleepy", "context": "Tiny fists finding eyes.", "context_zh": "小拳头找到了眼睛。", "expression": "*Fists rub at eyes, whimpery 'uh uh' protest*", "expression_zh": "*拳头揉眼睛，发出呜咽式的「唔 唔」抗议*", "signal": "Eye rub with whimper", "signal_zh": "揉眼 + 呜咽", "facial": "Teary lids", "facial_zh": "眼眶含泪", "body": "Fists to eyes", "body_zh": "拳头贴眼", "intent": "困+抗拒", "intent_en": "Sleepy and resisting", "parent_hint": "哄睡——抱摇", "parent_hint_en": "Settle to sleep — hold and rock", "default_tags": ["phase:1"]},
  {"id": "phase1_sleepy_overtired_arch_04", "trigger": "sleepy", "context": "Missed the sleep window, now overtired.", "context_zh": "错过了入睡窗口，现在过度疲劳。", "expression": "*Arching backward with shrill 'aaaaah', then collapses into hiccuping whimper*", "expression_zh": "*身体向后弓起发出尖锐的「啊啊啊啊」，随后瘫软成带抽气的呜咽*", "signal": "Overtired arch cry", "signal_zh": "过度疲劳的弓身哭", "facial": "Red scrunched", "facial_zh": "脸涨红皱成一团", "body": "Arched then limp", "body_zh": "先后弓后瘫软", "intent": "过度疲劳", "intent_en": "Overtired", "parent_hint": "包裹+白噪音+黑暗环境", "parent_hint_en": "Swaddle + white noise + darkness", "default_tags": ["phase:1", "arousal:high"]},
