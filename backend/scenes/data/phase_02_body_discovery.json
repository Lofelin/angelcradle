  {"id": "phase2_lonely_room_quiet_01", "trigger": "lonely", "context": "Playing alone too long.", "context_zh": "独自玩太久了。", "expression": "*Looks around, 'aaah?' calling, then whimper rising*", "expression_zh": "*环顾四周，发出「啊啊？」的呼唤，随后呜咽升级*", "signal": "Alone-call escalation", "signal_zh": "独处呼唤升级", "facial": "Searching", "facial_zh": "搜寻", "body": "Head turning", "body_zh": "转头", "intent": "没人陪", "intent_en": "No one around", "parent_hint": "回应——加入陪玩", "parent_hint_en": "Respond — join in to play together", "default_tags": ["phase:2"]},
  {"id": "phase2_lonely_mom_leaves_02", "trigger": "lonely", "context": "Mom leaves briefly.", "context_zh": "妈妈短暂离开。", "expression": "*Eyes to door, 'ma-ma?' urgent babble*", "expression_zh": "*眼睛盯着门，急切地咿呀「ma-ma？」*", "signal": "Door-seek babble", "signal_zh": "找门的咿呀", "facial": "Worried", "facial_zh": "担忧", "body": "Eyes on door", "body_zh": "眼睛盯着门", "intent": "妈妈离开了", "intent_en": "Mom has left", "parent_hint": "保持声音联系", "parent_hint_en": "Maintain voice contact", "default_tags": ["phase:2", "attachment:toward_secure"]},
  {"id": "phase2_lonely_crib_alone_03", "trigger": "lonely", "context": "Awake in crib, no one around.", "context_zh": "在小床里醒着，周围没人。", "expression": "*Stares at ceiling, soft 'oooh?' seeking, then louder*", "expression_zh": "*盯着天花板，轻柔地「噢噢？」寻求，随后变响*", "signal": "Crib-alone seek", "signal_zh": "小床独处的寻求", "facial": "Searching", "facial_zh": "搜寻", "body": "Staring up", "body_zh": "仰视上方", "intent": "婴儿床里无聊想人", "intent_en": "Bored in crib, wants company", "parent_hint": "抱出来互动", "parent_hint_en": "Pick up and interact", "default_tags": ["phase:2"]},
  {"id": "phase2_lonely_sibling_left_04", "trigger": "lonely", "context": "Older sibling left to school.", "context_zh": "哥哥姐姐上学走了。", "expression": "*Looks at the door where sibling left, 'aah?' sad coo*", "expression_zh": "*望着哥哥姐姐离开的门口，发出难过的「啊啊？」咕咕*", "signal": "Sibling-miss coo", "signal_zh": "想念兄姐的咕咕", "facial": "Sad", "facial_zh": "难过", "body": "Eyes on door", "body_zh": "眼睛盯着门", "intent": "哥哥/姐姐走了", "intent_en": "Sibling has left", "parent_hint": "替代互动", "parent_hint_en": "Offer alternative interaction", "default_tags": ["phase:2"]},

  {"id": "phase2_overstimulated_visitors_01", "trigger": "overstimulated", "context": "Too many visitors.", "context_zh": "来访客人太多。", "expression": "*Turns face away, 'uuuhh' withdraw, weak cry*", "expression_zh": "*脸转开，「呜呜」地退缩，发出微弱的哭声*", "signal": "Withdraw-hide", "signal_zh": "退缩躲藏", "facial": "Hidden", "facial_zh": "躲藏", "body": "Face-turn", "body_zh": "脸转开", "intent": "人太多", "intent_en": "Too many people", "parent_hint": "带到安静房间", "parent_hint_en": "Move to a quiet room", "default_tags": ["phase:2", "arousal:overstimulated"]},
  {"id": "phase2_overstimulated_stroller_outing_02", "trigger": "overstimulated", "context": "Long stroller outing, too much input.", "context_zh": "推车出门时间太长，输入过载。", "expression": "*Eyes unfocused, weak continuous whimper*", "expression_zh": "*眼神涣散，发出持续微弱的呜咽*", "signal": "Outing-overload whimper", "signal_zh": "外出超载的呜咽", "facial": "Dazed", "facial_zh": "恍惚", "body": "Slumped", "body_zh": "瘫软", "intent": "出门太久累", "intent_en": "Too long outing, exhausted", "parent_hint": "回家休息", "parent_hint_en": "Head home to rest", "default_tags": ["phase:2"]},

  {"id": "phase2_curious_own_hand_01", "trigger": "curious", "context": "Discovers own hands.", "context_zh": "发现了自己的手。", "expression": "*Brings hand to face, stares intently, 'aaaaahh' wonder, fingers wiggle*", "expression_zh": "*把手凑到脸前，专注凝视，发出惊叹的「啊啊啊」，手指扭动*", "signal": "Hand-discovery wonder", "signal_zh": "发现手的惊叹", "facial": "Fascinated", "facial_zh": "着迷", "body": "Hand to face", "body_zh": "手贴脸", "intent": "发现自己的手", "intent_en": "Discovering own hands", "parent_hint": "重要里程碑——不要打断", "parent_hint_en": "Important milestone — don't interrupt", "default_tags": ["phase:2", "capability:unlock:hand_discovery"]},
  {"id": "phase2_curious_mirror_first_02", "trigger": "curious", "context": "First time seeing mirror.", "context_zh": "第一次看见镜子。", "expression": "*Reaches for reflection with 'ba ba ba!', wide bright eyes*", "expression_zh": "*朝镜像伸手「ba ba ba！」，眼睛又大又亮*", "signal": "Mirror-reach babble", "signal_zh": "朝镜子伸手的咿呀", "facial": "Excited", "facial_zh": "兴奋", "body": "Reach", "body_zh": "伸手", "intent": "镜子里是什么", "intent_en": "What's in the mirror?", "parent_hint": "自我识别的前奏", "parent_hint_en": "Precursor to self-recognition", "default_tags": ["phase:2", "memory:positive"]},
  {"id": "phase2_curious_toy_texture_03", "trigger": "curious", "context": "New texture (silk, crinkly paper).", "context_zh": "新触感（丝绸、沙沙纸）。", "expression": "*Feels texture with tiny fingers, 'ooooh' soft wonder babble*", "expression_zh": "*用小手指感受触感，发出轻柔惊叹的「噢噢噢」咿呀*", "signal": "Texture-explore coo", "signal_zh": "触感探索的咕咕", "facial": "Focused", "facial_zh": "专注", "body": "Finger-feeling", "body_zh": "手指触摸", "intent": "新触感", "intent_en": "New texture sensation", "parent_hint": "多样触觉玩具", "parent_hint_en": "Provide varied tactile toys", "default_tags": ["phase:2", "sensory_dominant:touch"]},
  {"id": "phase2_curious_sound_rattle_04", "trigger": "curious", "context": "Shakes rattle, surprised by sound.", "context_zh": "摇晃摇铃，被声音惊讶。", "expression": "*Shakes again, eyes wide, 'ba-da-ba' excited babble*", "expression_zh": "*再摇一次，眼睛睁大，兴奋地「ba-da-ba」咿呀*", "signal": "Cause-effect discovery", "signal_zh": "因果关系的发现", "facial": "Delighted surprise", "facial_zh": "惊喜", "body": "Shake again", "body_zh": "再摇一次", "intent": "我摇它响", "intent_en": "I shake it, it makes sound", "parent_hint": "早期因果认知", "parent_hint_en": "Early cause-effect cognition", "default_tags": ["phase:2", "capability:unlock:simple_cause_effect"]},
  {"id": "phase2_curious_face_study_05", "trigger": "curious", "context": "Studying parent's face features.", "context_zh": "在研究父母的五官。", "expression": "*Pokes at mouth/nose with 'mmmmm', concentrated*", "expression_zh": "*戳着嘴巴或鼻子，嘴里「嗯嗯嗯」地全神贯注*", "signal": "Face-exploration poke", "signal_zh": "面部探索的戳", "facial": "Serious focus", "facial_zh": "严肃专注", "body": "Poking", "body_zh": "戳戳", "intent": "研究大人的脸", "intent_en": "Studying the adult face", "parent_hint": "回应——命名五官", "parent_hint_en": "Respond — name facial features", "default_tags": ["phase:2", "memory:positive"]},
  {"id": "phase2_curious_own_feet_06", "trigger": "curious", "context": "Discovers feet.", "context_zh": "发现了自己的脚。", "expression": "*Grabs foot with both hands, 'ba!' delighted, tries to bring to mouth*", "expression_zh": "*双手抓住脚，开心地「ba！」，试图把脚送进嘴里*", "signal": "Foot-discovery grab", "signal_zh": "发现脚的抓取", "facial": "Fascinated", "facial_zh": "着迷", "body": "Foot to mouth", "body_zh": "脚送向嘴", "intent": "脚是谁的？", "intent_en": "Whose foot is this?", "parent_hint": "身体认知——正常发育", "parent_hint_en": "Body awareness — normal development", "default_tags": ["phase:2", "capability:unlock:hand_discovery"]},
