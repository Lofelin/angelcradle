  {"id": "phase2_curious_pet_watch_08", "trigger": "curious", "context": "Watches family pet moving.", "context_zh": "看家里的宠物在动。", "expression": "*Tracks pet with fixed gaze, 'ba!' excited babble when it moves*", "expression_zh": "*目光锁定宠物，每次宠物动都兴奋地「ba！」*", "signal": "Pet-tracking babble", "signal_zh": "追踪宠物的咿呀", "facial": "Intent", "facial_zh": "专注", "body": "Tracking", "body_zh": "追视", "intent": "小动物好奇", "intent_en": "Curious about the pet", "parent_hint": "监督互动", "parent_hint_en": "Supervise the interaction", "default_tags": ["phase:2"]},

  {"id": "phase2_play_peekaboo_01", "trigger": "play", "context": "Parent playing peek-a-boo.", "context_zh": "父母在玩躲猫猫。", "expression": "*Laughs out loud, kicking legs with 'ha ha ha!' excitement*", "expression_zh": "*放声大笑，双腿踢动着「哈哈哈！」兴奋*", "signal": "Peekaboo laugh kick", "signal_zh": "躲猫猫的笑踢", "facial": "Big laugh", "facial_zh": "大笑", "body": "Leg kick", "body_zh": "踢腿", "intent": "躲猫猫好玩", "intent_en": "Peek-a-boo is fun", "parent_hint": "重复——强化依恋", "parent_hint_en": "Repeat — strengthens attachment", "default_tags": ["phase:2", "memory:positive", "capability:unlock:laugh"]},
  {"id": "phase2_play_bounce_lap_02", "trigger": "play", "context": "Bouncing on lap.", "context_zh": "在膝盖上蹦跳。", "expression": "*Squeals 'aaaaah!' with giggles every bounce*", "expression_zh": "*每次蹦跳都发出「啊啊啊！」的尖叫和咯咯笑声*", "signal": "Bounce-laugh squeal", "signal_zh": "蹦跳大笑尖叫", "facial": "Delighted", "facial_zh": "欣喜", "body": "Whole-body bounce", "body_zh": "全身上下弹动", "intent": "上下弹好玩", "intent_en": "Bouncing is fun", "parent_hint": "身体游戏——促进平衡", "parent_hint_en": "Body play — boosts balance", "default_tags": ["phase:2", "memory:positive"]},
  {"id": "phase2_play_toy_shake_03", "trigger": "play", "context": "Baby wants toy back.", "context_zh": "Baby 想要玩具回到手里。", "expression": "*Reaches with 'ba ba!', grunty demand, legs kicking*", "expression_zh": "*一边「ba ba！」伸手一边哼哼地要求，双腿踢动*", "signal": "Toy-reach demand", "signal_zh": "要玩具的伸手", "facial": "Urgent", "facial_zh": "急切", "body": "Reach", "body_zh": "伸手", "intent": "想要那个玩具", "intent_en": "Wants that toy", "parent_hint": "回应给玩具", "parent_hint_en": "Respond by giving the toy", "default_tags": ["phase:2"]},
  {"id": "phase2_play_parent_sing_04", "trigger": "play", "context": "Parent sings a silly song.", "context_zh": "家长在唱一首搞笑的歌。", "expression": "*Bobs body with music, 'ga ga ga' happy babble in rhythm*", "expression_zh": "*身体随音乐晃动，节奏性地咿呀「ga ga ga」*", "signal": "Music-rhythm babble", "signal_zh": "随乐节奏的咿呀", "facial": "Happy", "facial_zh": "开心", "body": "Body rocking", "body_zh": "身体摇摆", "intent": "音乐好玩", "intent_en": "Music is fun", "parent_hint": "继续唱——早期节奏感", "parent_hint_en": "Keep singing — early rhythm sense", "default_tags": ["phase:2", "memory:positive"]},
  {"id": "phase2_play_blow_raspberry_05", "trigger": "play", "context": "Discovers lip vibrations.", "context_zh": "发现了嘴唇能振动。", "expression": "*Blows raspberry 'bprrr bprrr', giggling at the sensation*", "expression_zh": "*连吹「bprrr bprrr」的口水泡，被这种感觉逗得咯咯笑*", "signal": "Raspberry discovery laugh", "signal_zh": "吹口水的发现笑", "facial": "Delighted silly", "facial_zh": "欣喜逗趣", "body": "Lip blow", "body_zh": "嘴唇吹气", "intent": "自己能发出搞笑声音", "intent_en": "Can make a funny sound myself", "parent_hint": "模仿——强化互动", "parent_hint_en": "Mimic back — strengthen interaction", "default_tags": ["phase:2", "memory:positive"]},

  {"id": "phase2_curious_share_discovery_09", "trigger": "share", "context": "Wants to show a found toy to caregiver.", "context_zh": "想把找到的玩具给照料者看。", "expression": "*Holds up toy toward adult with 'ba ba!'*", "expression_zh": "*把玩具举向大人，嘴里「ba ba！」*", "signal": "Show-up babble", "signal_zh": "举示 + 咿呀", "facial": "Proud", "facial_zh": "得意", "body": "Arm up", "body_zh": "举手", "intent": "给你看这个", "intent_en": "Look at this!", "parent_hint": "回应——夸赞物品", "parent_hint_en": "Respond — praise the object", "default_tags": ["phase:2"]},
  {"id": "phase2_curious_reach_far_10", "trigger": "curious", "context": "Object slightly out of reach.", "context_zh": "物体刚好够不到。", "expression": "*Stretches body, 'aaaaah!' effortful babble, inch-worming toward it*", "expression_zh": "*伸展身体，发出费力的「啊啊啊！」咿呀，像尺蠖一样挪过去*", "signal": "Out-of-reach effort", "signal_zh": "够不到的努力", "facial": "Determined", "facial_zh": "坚定", "body": "Stretch-worming", "body_zh": "伸展挪动", "intent": "想够到东西", "intent_en": "Wants to reach the object", "parent_hint": "离一点让 baby 自己努力", "parent_hint_en": "Keep it slightly out of reach, let baby work for it", "default_tags": ["phase:2", "capability:unlock:reach_for_objects"]},
  {"id": "phase2_share_show_foot_11", "trigger": "share", "context": "Wants to show new foot discovery.", "context_zh": "想展示新发现的脚。", "expression": "*Holds up foot, looks at adult with 'ba!' as if to say look*", "expression_zh": "*把脚抬起来，看着大人「ba！」仿佛在说「你看」*", "signal": "Foot-show babble", "signal_zh": "展示脚的咿呀", "facial": "Bright", "facial_zh": "明亮", "body": "Foot up", "body_zh": "抬脚", "intent": "看我的脚！", "intent_en": "Look at my foot!", "parent_hint": "回应——命名身体部位", "parent_hint_en": "Respond — name body parts", "default_tags": ["phase:2"]}
